save-exact = true
engine-strict = true
auto-install-peers = true
strict-peer-dependencies = false
shamefully-hoist = true
# Mirror npm's flat node_modules layout (symlinks → real files). Lets
# tests that historically reached into `@wordpress/components/node_modules/@wordpress/a11y`
# still resolve, and matches the resolution behaviour every contributor
# script was written against before the pnpm migration.
node-linker = hoisted
