# Optional configuration for a worktree's Docker environment.
#
# Main checkout (optional): copy this file to .env, or run `npm run worktree:setup`.
# Worktrees: run `npm run worktree:setup` to auto-generate .env.

# Port for this worktree's WordPress instance.
# Main checkout default: 8072. Worktrees: auto-assigned from 8170-8189.
# WORDPRESS_PORT=8072

# Unique identifier for this worktree (used in container names).
# Default: directory basename (sanitized to lowercase alphanumeric + underscore).
# WORKTREE_ID=feature-abc

# (optional) Override the shared WordPress path used by Docker bind volumes.
# Default: ./docker/wordpress in the main checkout.
# WCSTRIPE_SHARED_WP_PATH=/Users/yourname/Sites/wordpress
