{
    "name": "woocommerce/woocommerce-gateway-stripe-hooks-documentor",
    "description": "Generate hook documentation for woocommerce/woocommerce-gateway-stripe",
    "type": "library",
    "license": "GPL-2.0-or-later",
    "minimum-stability": "beta",
    "config": {
        "allow-plugins": {
            "composer/installers": true
        }
    },
    "scripts": {
        "generate:json": "vendor/bin/wp-hooks-generator --input=../../includes --output=tmp --ignore-hooks=woocommerce_cart_item_product,woocommerce_refund_deleted,wc-booking-remove-inactive-cart,woocommerce_is_email_preview,woocommerce_payment_complete_order_status,woocommerce_valid_order_statuses_for_payment_complete,woocommerce_add_to_cart_quantity,woocommerce_cart_shipping_packages,woocommerce_gateway_icon,woocommerce_gateway_description",
        "generate:markdown": "php class-hook-markdown-generator.php --ref=$(git rev-parse --abbrev-ref HEAD) --commit=$(git rev-parse HEAD)",
        "generate": [
            "@generate:json",
            "@generate:markdown"
        ]
    },
    "repositories": [
        {
            "type": "vcs",
            "url": "https://github.com/daledupreez/wp-hooks-generator"
        }
    ],
    "require-dev": {
        "wp-hooks/generator": "dev-try/add-support-for-deprecated-actions-and-filters#3405335054130e575078d947d6663a5764876a07"
    },
    "extra": {
        "wp-hooks": {
            "include-deprecated": true
        }
    }
}
