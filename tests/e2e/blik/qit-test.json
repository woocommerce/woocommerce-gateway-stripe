{
	"package": "woocommerce-gateway-stripe/e2e-blik",
	"package_type": "test",
	"test_type": "e2e",
	"description": "BLIK payment E2E tests (PLN, PL Stripe account)",
	"requires": {
		"network": true,
		"tunnel": true,
		"secrets": [ "STRIPE_PUB_KEY_PL", "STRIPE_SECRET_KEY_PL" ],
		"plugins": [ "woocommerce-subscriptions", "woocommerce-pre-orders" ]
	},
	"test": {
		"phases": {
			"globalSetup": [ "./bootstrap/global-setup.sh" ],
			"setup": [ "cd .. && npm install", "cd .. && npx playwright install chromium" ],
			"run": [
				"cd .. && npx playwright test --config=./qit/playwright.config.js --project=blik-setup --project=blik"
			],
			"teardown": [],
			"globalTeardown": [ "./bootstrap/global-teardown.sh" ]
		},
		"results": {
			"ctrf-json": "../results/ctrf.json",
			"blob-dir": "../results/blob",
			"allure-dir": "../results/allure"
		}
	}
}
