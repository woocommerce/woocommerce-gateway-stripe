# Stripe keys
# IMPORTANT: Please only use API keys from your personal Stripe account when running E2E tests.
STRIPE_PUB_KEY=<pk_test_xxx>
STRIPE_SECRET_KEY=<rk_test_xxx>


# GitHub token with access to the Woo Subscriptions and Woo Pre-Orders repositories.
# Optional: leave the placeholder (or empty) to fall back to the GitHub CLI, and then to zips placed in tests/e2e/deps/.
GITHUB_TOKEN=<ghp_xxxxxxxxxxxxxx>


# External test site config (e.g.: Jurassic.ninja)

# SSH credentials. WP CLI must be installed on it.
SSH_HOST=ssh.atomicsites.net
SSH_USER=<ssh_user>
SSH_PASSWORD=<ssh_password>
SSH_PATH=/srv/htdocs/

# The WP Admin credentials
ADMIN_USER=demo
ADMIN_PASSWORD=<password>
