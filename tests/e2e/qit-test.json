{
	"package": "woocommerce-gateway-stripe/e2e",
	"package_type": "test",
	"test_type": "e2e",
	"description": "E2E tests for WooCommerce Stripe Payment Gateway",
	"requires": {
		"network": true,
		"tunnel": true,
		"secrets": [ "STRIPE_PUB_KEY", "STRIPE_SECRET_KEY" ],
		"plugins": [ "woocommerce-subscriptions:latest", "woocommerce-pre-orders:latest" ]
	},
	"test": {
		"phases": {
			"globalSetup": [ "./qit/bootstrap/global-setup.sh" ],
			"setup": [ "npm install", "npx playwright install chromium" ],
			"run": [
				"npx playwright test --config=./qit/playwright.config.js --project=oc-setup --project=optimized-checkout",
				"npx playwright test --config=./qit/playwright.config.js --project=isk",
				"npx playwright test --config=./qit/playwright.config.js --project=acss-setup --project=acss",
				"npx playwright test --config=./qit/playwright.config.js --project=default-setup --project=default"
			],
			"teardown": [],
			"globalTeardown": [ "./qit/bootstrap/global-teardown.sh" ]
		},
		"results": {
			"ctrf-json": "./results/ctrf.json",
			"blob-dir": "./results/blob",
			"allure-dir": "./results/allure"
		}
	},
	"subpackages": {
		"woocommerce-gateway-stripe/e2e-acss": {
			"description": "ACSS Pre-Authorized Debit tests (CAD)",
			"test": {
				"phases": {
					"run": [
						"npx playwright test --config=./qit/playwright.config.js --project=acss-setup --project=acss"
					]
				}
			}
		},
		"woocommerce-gateway-stripe/e2e-becs": {
			"description": "BECS Direct Debit tests (AUD) - MUST provide Stripe AU account keys in STRIPE_PUB_KEY/STRIPE_SECRET_KEY",
			"test": {
				"phases": {
					"run": [
						"npx playwright test --config=./qit/playwright.config.js --project=becs-setup --project=becs"
					]
				}
			}
		},
		"woocommerce-gateway-stripe/e2e-blik": {
			"description": "BLIK tests (PLN) - MUST provide Stripe PL account keys in STRIPE_PUB_KEY/STRIPE_SECRET_KEY",
			"test": {
				"phases": {
					"run": [
						"npx playwright test --config=./qit/playwright.config.js --project=blik-setup --project=blik"
					]
				}
			}
		},
		"woocommerce-gateway-stripe/e2e-default": {
			"description": "Default tests (USD)",
			"test": {
				"phases": {
					"run": [
						"npx playwright test --config=./qit/playwright.config.js --project=default-setup --project=default"
					]
				}
			}
		},
		"woocommerce-gateway-stripe/e2e-isk": {
			"description": "ISK/Icelandic Króna express checkout tests",
			"test": {
				"phases": {
					"run": [
						"npx playwright test --config=./qit/playwright.config.js --project=isk"
					]
				}
			}
		},
		"woocommerce-gateway-stripe/e2e-optimized-checkout": {
			"description": "Optimized Checkout Suite tests",
			"test": {
				"phases": {
					"run": [
						"npx playwright test --config=./qit/playwright.config.js --project=oc-setup --project=optimized-checkout"
					]
				}
			}
		}
	}
}
