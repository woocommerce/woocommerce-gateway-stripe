# WordPress
WORDPRESS_DB_HOST=wcstripe_db:3306
WORDPRESS_DB_USER=wordpress
WORDPRESS_DB_PASSWORD=wordpress
WORDPRESS_DB_NAME=wordpress
WORDPRESS_DEBUG=1
ABSPATH=/usr/src/wordpress/

# Database
MYSQL_ROOT_PASSWORD=wordpress
MYSQL_DATABASE=wordpress
MYSQL_USER=wordpress
MYSQL_PASSWORD=wordpress

# phpMyAdmin
PMA_HOST=wcstripe_db
PMA_USER=root
PMA_PASSWORD=wordpress

# Increase uploads limit
UPLOAD_LIMIT=2G

# Stripe
WC_STRIPE_DIR=/var/www/html/wp-content/plugins/woocommerce-gateway-stripe

# Shared WordPress path for Docker bind-mount volumes (plugins, themes, uploads, mu-plugins).
# Resolved to an absolute path by bin/docker-infra-up.sh.
WCSTRIPE_SHARED_WP_PATH=./docker/wordpress

# Database data path (resolved to absolute path by bin/docker-infra-up.sh).
WCSTRIPE_DB_DATA_PATH=./docker/data
